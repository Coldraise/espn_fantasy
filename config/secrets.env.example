# Copy to secrets.env, then: chmod 600 config/secrets.env
#
# Pull both from a logged-in ESPN session:
#   devtools -> Application -> Cookies -> https://fantasy.espn.com
#
# Paste values raw. Do NOT quote them and do NOT url-decode espn_s2 --
# Compose passes env_file values through literally.
ESPN_S2=
SWID={00000000-0000-0000-0000-000000000000}
